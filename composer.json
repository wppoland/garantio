{
    "name": "wppoland/garantio",
    "description": "Legal guarantee reminder, durability guarantee note, repairability class badge and green claims phrase check for WooCommerce (Directive (EU) 2024/825).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^10.8"
    },
    "autoload": {
        "psr-4": {
            "Garantio\\": "src/"
        }
    },
    "scripts": {
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs:fix": "phpcbf --standard=phpcs.xml.dist",
        "analyse": "phpstan analyse -c phpstan.neon.dist --memory-limit=2G",
        "test": "php tests/guarantee-notice-check.php && php tests/uninstall-multisite-check.php && php tests/settings-capability-check.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
